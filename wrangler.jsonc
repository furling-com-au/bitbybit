{
  "name": "bitbybit",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",

  // Static pages live in /public; the Worker only runs for dynamic routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/s/*", "/e/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitbybit",
      // npx wrangler d1 create bitbybit  → paste the id here
      "database_id": "PASTE_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
