node_modules/
.wrangler/
.dev.vars

# Local operational data: the daily stats watcher appends to this.
.stats-history.jsonl

# Local D1 dumps. These hold real production rows — participant names and
# organiser edit_tokens in plaintext — and the edit token is the only
# credential a board has. This repo is public; the backups stay local.
backups/

# Claude Code's scratch worktrees (a full second copy of the repo).
.claude/worktrees/

# Dev-server logs. Note this only keeps them out of git - wrangler does NOT
# read .gitignore, so what actually stops a deploy publishing them is
# public/.assetsignore, checked by scripts/check-public-assets.mjs.
public/*.log
